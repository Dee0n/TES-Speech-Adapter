diff --git a/src/mcp/server.ts b/src/mcp/server.ts
index b1383fe..745a3c6 100644
--- a/src/mcp/server.ts
+++ b/src/mcp/server.ts
@@ -122,16 +122,29 @@ export class McpServer {
     });
   }
 
+  private transports = new Map<string, SSEServerTransport>();
+
   async handleSseConnection(req: Request, res: Response): Promise<void> {
     const transport = new SSEServerTransport('/message', res);
+    this.transports.set(transport.sessionId, transport);
     await this.server.connect(transport);
 
     // Handle client disconnection
     req.on('close', () => {
+      this.transports.delete(transport.sessionId);
       transport.close();
     });
   }
 
+  async handlePostMessage(req: Request, res: Response): Promise<void> {
+    const transport = this.transports.get(String(req.query.sessionId ?? ''));
+    if (!transport) {
+      res.status(400).send('Unknown or expired MCP session');
+      return;
+    }
+    await transport.handlePostMessage(req, res, req.body);
+  }
+
   getServer(): Server {
     return this.server;
   }
