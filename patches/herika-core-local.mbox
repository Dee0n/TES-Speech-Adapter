 // action_post_process_fnct_ex is an arrya containing functions that process the actions after they are generated by the LLM
 // more working examples in data_functions.php
+// TES-GOLD-HANDOVER (2026-10-03, live: the player offered Назим a million septims; he kept
+// opening the gift window (OpenInventory2) or just saying "я открыл инвентарь, готов принять"
+// and never called TakeGoldFromPlayer). When the player's own words HAND OVER money with an
+// amount, the NPC takes it via TakeGoldFromPlayer: a trade/gift-window action is replaced, and
+// a turn with no money action at all gets one. At most once per NPC per 2 minutes.
+function tesGoldHandoverAmount(string $input): int
+{
+    $t = mb_strtolower($input);
+    if (!preg_match('/(?<!\p{L})(держи|возьми|бери|забирай|дарю|даю|дам|отдаю|отдам|плачу|заплачу|получи|прими|вот\s+тебе|вот\s+твои)(?!\p{L})/u', $t)) {
+        return 0;
+    }
+    if (!preg_match('/(деньг|золот|септим|монет|миллион|тысяч|сотн|\d)/u', $t)) {
+        return 0;
+    }
+    $mult = ['миллион' => 1000000, 'тысяч' => 1000, 'сотн' => 100, 'сто' => 100];
+    if (preg_match('/(\d[\d\s]*)\s*(миллион|тысяч|сотн)?/u', $t, $m)) {
