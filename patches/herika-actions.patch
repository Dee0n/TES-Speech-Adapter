+// Narrator "god mode": run Skyrim console commands through the quest-engine action
+// outbox, which the AIAgent plugin polls and executes (action_type console_command).
+// Placeholders: {item:English Name} -> item FormID from the descriptions DB,
+// {weather:Clear|Cloudy|Fog|Rain|Thunderstorm|Snow|Blizzard|Dark} -> weather FormID,
+// "Name [RefID: 0001A66E]" -> 0001A66E.
+function herikaQueueGodCommands($commandText)
+{
+    if (!isset($GLOBALS["db"])) {
+        return 0;
+    }
+    $weathers = [
+        'clear' => '0000081A', 'cloudy' => '00012F89', 'fog' => '000C821E', 'rain' => '000C821F',
+        'thunderstorm' => '000C8220', 'storm' => '000C8220', 'snow' => '0004D7FB',
+        'blizzard' => '000C8221', 'dark' => '000D299E',
+    ];
+    $text = preg_replace('/\[RefID:\s*([0-9A-Fa-f]{8})\]/u', '$1', strval($commandText)) ?? '';
+    // {npc:Name} -> RefID of a known NPC (exact name first, then prefix match)
+    $text = preg_replace_callback('/\{npc:([^}]+)\}/iu', function ($m) {
+        $name = $GLOBALS["db"]->escape(trim($m[1]));
+        $row = $GLOBALS["db"]->fetchOne("SELECT refid FROM public.core_npc_master WHERE npc_name ILIKE '{$name}' OR npc_name ILIKE '{$name} %' OR npc_name ILIKE '{$name} [%' ORDER BY length(npc_name) LIMIT 1");
+        $refId = strtoupper(trim(strval($row['refid'] ?? '')));
+        if ($refId === '') {
+            // Not (or no longer) in core_npc_master: take the RefID from the latest
+            // "addnpc" event the game sent for that name ("Name@Name@gender@race@RefID@...").
+            $event = $GLOBALS["db"]->fetchOne("SELECT data FROM public.eventlog WHERE type = 'addnpc' AND (data ILIKE '{$name}@%' OR data ILIKE '{$name} %@%') ORDER BY localts DESC LIMIT 1");
+            $parts = explode('@', strval($event['data'] ?? ''));
+            $refId = strtoupper(trim(strval($parts[4] ?? '')));
+        }
+        return preg_match('/^[0-9A-F]{8}$/', $refId) ? $refId : $m[0];
+    }, $text) ?? $text;
+    $text = preg_replace('/[А-Яа-яЁё][А-Яа-яЁё\'\-]*\s*/u', '', $text) ?? $text;  // actor names; commands are ASCII
+    $text = preg_replace_callback('/\{weather:([^}]+)\}/i', function ($m) use ($weathers) {
+        return $weathers[strtolower(trim($m[1]))] ?? '0000081A';
+    }, $text) ?? $text;
+    // Skyrim.esm EXPL / LVLN records (tools/esm_weathers.py <esm> <regex> EXPL|LVLN)
+    $explosions = [
+        'fire' => '0010FBE9', 'frost' => '000ED39B', 'shock' => '0003BF7A',
+        'big' => '00016C46', 'huge' => '0010FE9F', 'visual' => '000EA517',
+    ];
+    $spawns = [
+        'bandit' => '0001B0E9', 'mage' => '0001B0FB', 'archer' => '0001A348', 'boss' => '000E1645',
+    ];
+    $text = preg_replace_callback('/\{(explosion|spawn):([^}]+)\}/i', function ($m) use ($explosions, $spawns) {
+        $table = strtolower($m[1]) === 'explosion' ? $explosions : $spawns;
+        return $table[strtolower(trim($m[2]))] ?? $m[0];  // unknown stays braced -> blocked
+    }, $text) ?? $text;
+    $text = preg_replace_callback('/\{item:([^}]+)\}/i', function ($m) {
+        $item = herikaResolveSpawnItemDescriptionMatch(trim($m[1]));
+        $formId = strval($item['runtime_formid'] ?? '');
+        return $formId !== '' ? $formId : $m[0];  // unresolved stays braced -> blocked below
+    }, $text) ?? $text;
+
+    $questKey = $GLOBALS["db"]->fetchOne("SELECT quest_key FROM public.skyrim_quest_instances ORDER BY quest_key LIMIT 1");
+    $questKey = strval($questKey['quest_key'] ?? '');
+    if ($questKey === '') {
+        error_log("[GOD] No quest instance row to attach console commands to");
+        return 0;
+    }
+
+    // Verified in game: through ConsoleUtil "0001A6A4.resurrect" silently does nothing,
+    // and a "prid" sent as a separate row is lost before the next row runs. Commands
+    // aimed at an NPC therefore go as ONE console_command_sequence: prid, then command.
+    $steps = [];
+    foreach (preg_split('/[;\n]+/', $text) as $command) {
+        $command = trim($command);
+        if ($command === '' || count($steps) >= 8) {
+            continue;
+        }
+        if (preg_match('/^(qqq|quitgame|save|load|saveini|reloadscript|coc\s*$)|\{|\}/i', $command)) {
+            error_log("[GOD] Blocked console command: {$command}");
+            continue;
+        }
+        if (preg_match('/^([0-9A-Fa-f]{8})\.\s*(.+)$/', $command, $m)) {
+            $steps[] = ['type' => 'console_command_sequence',
+                        'commands' => ['prid ' . strtoupper($m[1]), trim($m[2])]];
+        } else {
+            $steps[] = ['type' => 'console_command', 'command' => $command];
+        }
+    }
+
+    $queued = 0;
+    foreach ($steps as $step) {
+        $GLOBALS["db"]->insert('skyrim_quest_action_outbox', [
+            'quest_key' => $questKey,
+            'beat_id' => 'chim_god_command',
+            'action_type' => $step['type'],
+            'payload_json' => json_encode($step, JSON_UNESCAPED_UNICODE),
+        ]);
+        error_log("[GOD] Queued " . json_encode($step, JSON_UNESCAPED_UNICODE));
+        $queued++;
+    }
+    return $queued;
+}
